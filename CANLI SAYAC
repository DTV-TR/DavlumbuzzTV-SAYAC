<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Davlumbuzz TV - Canlı İstatistikler</title>
    <!-- Tailwind CSS ve FontAwesome CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta+Sans', sans-serif; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between">

    <!-- Header / Bilgi Alanı -->
    <div class="max-w-4xl mx-auto px-4 py-12 w-full text-center">
        <div class="inline-flex items-center gap-2 bg-red-500/10 border border-red-500/20 text-red-400 px-4 py-1.5 rounded-full text-sm font-semibold mb-6 animate-pulse">
            <span class="w-2 h-2 rounded-full bg-red-500"></span> Canlı Kanal Takipçisi
        </div>
        <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight mb-2">Davlumbuzz TV</h1>
        <p class="text-slate-400 text-sm md:text-base">YouTube İstatistikleri Canlı Takip Paneli</p>
    </div>

    <!-- İstatistik Kartları (Social Blade altyapısı ile anlık çekilir) -->
    <div class="max-w-4xl mx-auto px-4 w-full grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        
        <!-- Abone Kartı -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl relative overflow-hidden group hover:border-red-500/50 transition-all">
            <div class="absolute -right-4 -bottom-4 text-slate-800/40 text-7xl group-hover:text-red-500/10 transition-colors">
                <i class="fa-solid fa-users"></i>
            </div>
            <div class="text-red-500 text-2xl mb-4">
                <i class="fa-solid fa-users"></i>
            </div>
            <h3 class="text-slate-400 text-sm font-medium uppercase tracking-wider mb-1">Abone Sayısı</h3>
            <iframe src="https://livecounts.io/embed/youtube-live-subscriber-count/UCpLu4UnuANFstfgPuCZ6_uA" style="width:100%; height:50px; border:0; background:transparent;" scrolling="no"></iframe>
        </div>

        <!-- Toplam İzlenme Kartı -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl relative overflow-hidden group hover:border-red-500/50 transition-all">
            <div class="absolute -right-4 -bottom-4 text-slate-800/40 text-7xl group-hover:text-red-500/10 transition-colors">
                <i class="fa-solid fa-eye"></i>
            </div>
            <div class="text-blue-500 text-2xl mb-4">
                <i class="fa-solid fa-eye"></i>
            </div>
            <h3 class="text-slate-400 text-sm font-medium uppercase tracking-wider mb-1">Kanal Durumu</h3>
            <p class="text-xl font-bold text-white mt-2">Aktif ve Yayında 🚀</p>
        </div>

        <!-- Sosyal Blade / Canlı Sayaç Bağlantısı -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl relative overflow-hidden group hover:border-red-500/50 transition-all flex flex-col justify-between">
            <div>
                <div class="text-emerald-500 text-2xl mb-4">
                    <i class="fa-solid fa-chart-line"></i>
                </div>
                <h3 class="text-slate-400 text-sm font-medium uppercase tracking-wider mb-1">Detaylı İstatistik</h3>
                <p class="text-xs text-slate-400 mt-1">Anlık tam ekran sayaç için aşağıdaki butona tıklayabilirsin.</p>
            </div>
            <a href="https://socialblade.com/youtube/channel/UCpLu4UnuANFstfgPuCZ6_uA" target="_blank" class="mt-4 inline-block bg-red-600 hover:bg-red-700 text-white text-center py-2 px-4 rounded-xl text-sm font-semibold transition-colors">
                Social Blade Aç <i class="fa-solid fa-external-link-alt ml-1"></i>
            </a>
        </div>

    </div>

    <!-- Footer -->
    <footer class="text-center py-6 text-xs text-slate-500 border-t border-slate-900">
        Davlumbuzz TV için özel olarak hazırlanmıştır.
    </footer>
</body>
</html>
